# Copy to .env.local and adjust per environment.

# Base URL used for metadata (canonical links, Open Graph, sitemap).
# Update to the production domain before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings -> API in the Supabase dashboard).
# NEXT_PUBLIC_* keys are safe to expose to the browser; the service role key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) - used to email the firm when a new enquiry comes in.
RESEND_API_KEY=
# Where enquiry notifications are sent. Falls back to the firm's primary email if unset.
ENQUIRY_NOTIFICATION_EMAIL=
